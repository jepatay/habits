rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      // Admin creates the user doc right after creating the Auth account.
      allow create: if isAdmin();
      // Members may update their own doc (e.g. theme color, push tokens) but
      // never their own role - only an admin can grant/revoke admin.
      allow update: if isAdmin() ||
        (isSelf(uid) && !('role' in request.resource.data.diff(resource.data).affectedKeys()));
      allow delete: if isAdmin();
    }

    match /habits/{habitId} {
      allow read: if isSignedIn() && (resource.data.owner_uid == request.auth.uid || isAdmin());
      // Members manage their own habits (create/edit/archive/reorder);
      // admin can do the same for anyone, e.g. setting habits up for a
      // member who'd rather have them handed to them.
      allow create: if isSignedIn() && (request.resource.data.owner_uid == request.auth.uid || isAdmin());
      allow update, delete: if isSignedIn() && (resource.data.owner_uid == request.auth.uid || isAdmin());
    }

    match /entries/{entryId} {
      allow read: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      // Entries are normally only writable by whoever logged them, but the
      // admin also needs to write entries on a member's behalf for the
      // historical-data import feature (Settings > Import/Export, admin-only
      // in the UI) - so admin gets the same write access here as elsewhere.
      allow create: if isSignedIn() && (request.resource.data.user_id == request.auth.uid || isAdmin());
      allow update, delete: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
    }

    match /rewards/{rewardId} {
      allow read: if isSignedIn() && (resource.data.owner_uid == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }
  }
}
